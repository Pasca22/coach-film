{
  "name": "coach-film",
  "version": "0.1.0",
  "private": true,
  "description": "Localhost demo: tag a basketball match video and assign clips to players.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js --prod",
    "test": "node --disable-warning=ExperimentalWarning --test server/*.test.js",
    "typecheck": "tsc --noEmit -p client"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
